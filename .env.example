# SLAMS frontend environment (Vite).
# Copy to .env for local development (Vite auto-loads .env; VITE_ vars are
# inlined into the client bundle at build time).

# Base URL of the Cloudflare Workers API.
#   local dev:  leave UNSET — the Vite dev server proxies /api to the Worker
#               at http://127.0.0.1:8787 automatically (same origin, no CORS).
#   production: set to your Worker's URL, e.g.
#               https://slams-api.<subdomain>.workers.dev
# On Vercel, set VITE_API_URL in the project's Environment Variables
# (applies to all environments; per-preview values possible too).
#VITE_API_URL=https://slams-api.example.workers.dev

# Public base URL of the deployed frontend (used ONLY at build time to
# generate dist/sitemap.xml with absolute URLs). Set it in Vercel alongside
# VITE_API_URL. On Vercel this is optional — the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically.
#SITE_URL=https://attendance.example.edu
